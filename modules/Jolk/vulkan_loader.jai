    DeviceWaitIdle = cast(Proc_DeviceWaitIdle) load(handle, "vkDeviceWaitIdle".data);
    AllocateMemory = cast(Proc_AllocateMemory) load(handle, "vkAllocateMemory".data);
    FreeMemory = cast(Proc_FreeMemory) load(handle, "vkFreeMemory".data);
    MapMemory = cast(Proc_MapMemory) load(handle, "vkMapMemory".data);
    UnmapMemory = cast(Proc_UnmapMemory) load(handle, "vkUnmapMemory".data);
    FlushMappedMemoryRanges = cast(Proc_FlushMappedMemoryRanges) load(handle, "vkFlushMappedMemoryRanges".data);
    InvalidateMappedMemoryRanges = cast(Proc_InvalidateMappedMemoryRanges) load(handle, "vkInvalidateMappedMemoryRanges".data);
    GetDeviceMemoryCommitment = cast(Proc_GetDeviceMemoryCommitment) load(handle, "vkGetDeviceMemoryCommitment".data);
    GetBufferMemoryRequirements = cast(Proc_GetBufferMemoryRequirements) load(handle, "vkGetBufferMemoryRequirements".data);
    BindBufferMemory = cast(Proc_BindBufferMemory) load(handle, "vkBindBufferMemory".data);
    GetImageMemoryRequirements = cast(Proc_GetImageMemoryRequirements) load(handle, "vkGetImageMemoryRequirements".data);
    BindImageMemory = cast(Proc_BindImageMemory) load(handle, "vkBindImageMemory".data);
    GetImageSparseMemoryRequirements = cast(Proc_GetImageSparseMemoryRequirements) load(handle, "vkGetImageSparseMemoryRequirements".data);
