load_device_commands :: (handle: *void, load: Loader_Proc) {
    DestroyDevice = cast(Proc_DestroyDevice) load(handle, "vkDestroyDevice".data);
    GetDeviceQueue = cast(Proc_GetDeviceQueue) load(handle, "vkGetDeviceQueue".data);
    QueueSubmit = cast(Proc_QueueSubmit) load(handle, "vkQueueSubmit".data);
