FormatFeatureFlagBits :: enum_flags u32 #specified {
    SAMPLED_IMAGE_BIT :: 0x00000001;   // Format can be used for sampled images (SAMPLED_IMAGE and COMBINED_IMAGE_SAMPLER descriptor types)
    STORAGE_IMAGE_BIT :: 0x00000002;   // Format can be used for storage images (STORAGE_IMAGE descriptor type)
    STORAGE_IMAGE_ATOMIC_BIT :: 0x00000004;   // Format supports atomic operations in case it is used for storage images
    UNIFORM_TEXEL_BUFFER_BIT :: 0x00000008;   // Format can be used for uniform texel buffers (TBOs)
    STORAGE_TEXEL_BUFFER_BIT :: 0x00000010;   // Format can be used for storage texel buffers (IBOs)
    STORAGE_TEXEL_BUFFER_ATOMIC_BIT :: 0x00000020;   // Format supports atomic operations in case it is used for storage texel buffers
    VERTEX_BUFFER_BIT :: 0x00000040;   // Format can be used for vertex buffers (VBOs)
    COLOR_ATTACHMENT_BIT :: 0x00000080;   // Format can be used for color attachment images
    COLOR_ATTACHMENT_BLEND_BIT :: 0x00000100;   // Format supports blending in case it is used for color attachment images
    DEPTH_STENCIL_ATTACHMENT_BIT :: 0x00000200;   // Format can be used for depth/stencil attachment images
    BLIT_SRC_BIT :: 0x00000400;   // Format can be used as the source image of blits with vkCmdBlitImage
    BLIT_DST_BIT :: 0x00000800;   // Format can be used as the destination image of blits with vkCmdBlitImage
    SAMPLED_IMAGE_FILTER_LINEAR_BIT :: 0x00001000;   // Format can be filtered with VK_FILTER_LINEAR when being sampled
    TRANSFER_SRC_BIT :: 0x00004000;   // Format can be used as the source image of image transfer commands
    TRANSFER_DST_BIT :: 0x00008000;   // Format can be used as the destination image of image transfer commands
    MIDPOINT_CHROMA_SAMPLES_BIT :: 0x00020000;   // Format can have midpoint rather than cosited chroma samples
    SAMPLED_IMAGE_YCBCR_CONVERSION_LINEAR_FILTER_BIT :: 0x00040000;   // Format can be used with linear filtering whilst color conversion is enabled
    SAMPLED_IMAGE_YCBCR_CONVERSION_SEPARATE_RECONSTRUCTION_FILTER_BIT :: 0x00080000;   // Format can have different chroma, min and mag filters
    SAMPLED_IMAGE_YCBCR_CONVERSION_CHROMA_RECONSTRUCTION_EXPLICIT_BIT :: 0x00100000;
    SAMPLED_IMAGE_YCBCR_CONVERSION_CHROMA_RECONSTRUCTION_EXPLICIT_FORCEABLE_BIT :: 0x00200000;
    DISJOINT_BIT :: 0x00400000;   // Format supports disjoint planes
    COSITED_CHROMA_SAMPLES_BIT :: 0x00800000;   // Format can have cosited rather than midpoint chroma samples
    SAMPLED_IMAGE_FILTER_MINMAX_BIT :: 0x00010000;   // Format can be used with min/max reduction filtering
