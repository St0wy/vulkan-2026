    BLOCK_TEXEL_VIEW_COMPATIBLE_BIT :: 0x00000080;
    EXTENDED_USAGE_BIT :: 0x00000100;
    PROTECTED_BIT :: 0x00000800;   // Image requires protected memory
    DISJOINT_BIT :: 0x00000200;
