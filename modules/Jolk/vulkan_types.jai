    HOST_VISIBLE_BIT :: 0x00000002;   // Memory is mappable by host
    HOST_COHERENT_BIT :: 0x00000004;   // Memory will have i/o coherency. If not set, application may need to use vkFlushMappedMemoryRanges and vkInvalidateMappedMemoryRanges to flush/invalidate host cache
    HOST_CACHED_BIT :: 0x00000008;   // Memory will be cached by the host
    LAZILY_ALLOCATED_BIT :: 0x00000010;   // Memory may be allocated by the driver when it is required
    PROTECTED_BIT :: 0x00000020;   // Memory is protected
    DEVICE_COHERENT_BIT_AMD :: 0x00000040;
    DEVICE_UNCACHED_BIT_AMD :: 0x00000080;
    RDMA_CAPABLE_BIT_NV :: 0x00000100;
}

// MemoryHeapFlagBits (VkMemoryHeapFlagBits) -- https://registry.khronos.org/vulkan/specs/latest/man/html/VkMemoryHeapFlagBits.html
MemoryHeapFlagBits :: enum_flags u32 #specified {
    DEVICE_LOCAL_BIT :: 0x00000001;   // If set, heap represents device memory
    MULTI_INSTANCE_BIT :: 0x00000002;   // If set, heap allocations allocate multiple instances by default
    TILE_MEMORY_BIT_QCOM :: 0x00000008;

    // Aliases (promoted or renamed by a later version or extension).
    MULTI_INSTANCE_BIT_KHR :: MULTI_INSTANCE_BIT;
}

// AccessFlagBits (VkAccessFlagBits) -- https://registry.khronos.org/vulkan/specs/latest/man/html/VkAccessFlagBits.html
AccessFlagBits :: enum_flags u32 #specified {
    INDIRECT_COMMAND_READ_BIT :: 0x00000001;   // Controls coherency of indirect command reads
    INDEX_READ_BIT :: 0x00000002;   // Controls coherency of index reads
    VERTEX_ATTRIBUTE_READ_BIT :: 0x00000004;   // Controls coherency of vertex attribute reads
    UNIFORM_READ_BIT :: 0x00000008;   // Controls coherency of uniform buffer reads
    INPUT_ATTACHMENT_READ_BIT :: 0x00000010;   // Controls coherency of input attachment reads
    SHADER_READ_BIT :: 0x00000020;   // Controls coherency of shader reads
    SHADER_WRITE_BIT :: 0x00000040;   // Controls coherency of shader writes
    COLOR_ATTACHMENT_READ_BIT :: 0x00000080;   // Controls coherency of color attachment reads
    COLOR_ATTACHMENT_WRITE_BIT :: 0x00000100;   // Controls coherency of color attachment writes
    DEPTH_STENCIL_ATTACHMENT_READ_BIT :: 0x00000200;   // Controls coherency of depth/stencil attachment reads
    DEPTH_STENCIL_ATTACHMENT_WRITE_BIT :: 0x00000400;   // Controls coherency of depth/stencil attachment writes
    TRANSFER_READ_BIT :: 0x00000800;   // Controls coherency of transfer reads
    TRANSFER_WRITE_BIT :: 0x00001000;   // Controls coherency of transfer writes
    HOST_READ_BIT :: 0x00002000;   // Controls coherency of host reads
    HOST_WRITE_BIT :: 0x00004000;   // Controls coherency of host writes
    MEMORY_READ_BIT :: 0x00008000;   // Controls coherency of memory reads
    MEMORY_WRITE_BIT :: 0x00010000;   // Controls coherency of memory writes
    NONE :: 0;
    TRANSFORM_FEEDBACK_WRITE_BIT_EXT :: 0x02000000;
    TRANSFORM_FEEDBACK_COUNTER_READ_BIT_EXT :: 0x04000000;
    TRANSFORM_FEEDBACK_COUNTER_WRITE_BIT_EXT :: 0x08000000;
    CONDITIONAL_RENDERING_READ_BIT_EXT :: 0x00100000;   // read access flag for reading conditional rendering predicate
    COLOR_ATTACHMENT_READ_NONCOHERENT_BIT_EXT :: 0x00080000;
    ACCELERATION_STRUCTURE_READ_BIT_KHR :: 0x00200000;
    ACCELERATION_STRUCTURE_WRITE_BIT_KHR :: 0x00400000;
    FRAGMENT_DENSITY_MAP_READ_BIT_EXT :: 0x01000000;
    FRAGMENT_SHADING_RATE_ATTACHMENT_READ_BIT_KHR :: 0x00800000;
    COMMAND_PREPROCESS_READ_BIT_EXT :: 0x00020000;
    COMMAND_PREPROCESS_WRITE_BIT_EXT :: 0x00040000;

    // Aliases (promoted or renamed by a later version or extension).
