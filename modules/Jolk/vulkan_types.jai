    MULTISAMPLED_RENDER_TO_SINGLE_SAMPLED_BIT_EXT :: 0x00040000;
    _2D_VIEW_COMPATIBLE_BIT_EXT :: 0x00020000;   // Image is created with a layout where individual slices are capable of being used as 2D images
    VIDEO_PROFILE_INDEPENDENT_BIT_KHR :: 0x00100000;
    FRAGMENT_DENSITY_MAP_OFFSET_BIT_EXT :: 0x00008000;
    ALIAS_SINGLE_LAYER_DESCRIPTOR_BIT_KHR :: 0x00400000;

    // Aliases (promoted or renamed by a later version or extension).
    SPLIT_INSTANCE_BIND_REGIONS_BIT_KHR :: SPLIT_INSTANCE_BIND_REGIONS_BIT;
    _2D_ARRAY_COMPATIBLE_BIT_KHR :: _2D_ARRAY_COMPATIBLE_BIT;
    BLOCK_TEXEL_VIEW_COMPATIBLE_BIT_KHR :: BLOCK_TEXEL_VIEW_COMPATIBLE_BIT;
    EXTENDED_USAGE_BIT_KHR :: EXTENDED_USAGE_BIT;
    DISJOINT_BIT_KHR :: DISJOINT_BIT;
    ALIAS_BIT_KHR :: ALIAS_BIT;
    DESCRIPTOR_BUFFER_CAPTURE_REPLAY_BIT_EXT :: DESCRIPTOR_HEAP_CAPTURE_REPLAY_BIT_EXT;
