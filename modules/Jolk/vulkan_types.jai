    arrayLayers : u32;
    samples : SampleCountFlagBits;
    tiling : ImageTiling;
    usage : ImageUsageFlags;   // Image usage flags
    sharingMode : SharingMode;   // Cross-queue-family sharing mode
    queueFamilyIndexCount : u32;   // Number of queue families to share across
    pQueueFamilyIndices : *u32;   // Array of queue family indices to share across
    initialLayout : ImageLayout;   // Initial image layout for all subresources
}

