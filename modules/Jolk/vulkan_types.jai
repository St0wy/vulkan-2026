} // VK_USE_PLATFORM_OHOS


// --------------------------------------------------------------------------
// Callback types
// --------------------------------------------------------------------------

// These are called by the driver, so they are #c_call and get no Jai context. Use
// `push_context` inside one before calling anything that needs a context.

Proc_InternalAllocationNotification :: #type (pUserData: *void, size: u64, allocationType: InternalAllocationType, allocationScope: SystemAllocationScope) #c_call;
Proc_InternalFreeNotification :: #type (pUserData: *void, size: u64, allocationType: InternalAllocationType, allocationScope: SystemAllocationScope) #c_call;
Proc_ReallocationFunction :: #type (pUserData: *void, pOriginal: *void, size: u64, alignment: u64, allocationScope: SystemAllocationScope) -> *void #c_call;
Proc_AllocationFunction :: #type (pUserData: *void, size: u64, alignment: u64, allocationScope: SystemAllocationScope) -> *void #c_call;
Proc_FreeFunction :: #type (pUserData: *void, pMemory: *void) #c_call;
Proc_VoidFunction :: #type () #c_call;
Proc_DebugReportCallbackEXT :: #type (flags: DebugReportFlagsEXT, objectType: DebugReportObjectTypeEXT, object: u64, location: u64, messageCode: s32, pLayerPrefix: *u8, pMessage: *u8, pUserData: *void) -> Bool32 #c_call;
Proc_DebugUtilsMessengerCallbackEXT :: #type (messageSeverity: DebugUtilsMessageSeverityFlagBitsEXT, messageTypes: DebugUtilsMessageTypeFlagsEXT, pCallbackData: *DebugUtilsMessengerCallbackDataEXT, pUserData: *void) -> Bool32 #c_call;
Proc_DeviceMemoryReportCallbackEXT :: #type (pCallbackData: *DeviceMemoryReportCallbackDataEXT, pUserData: *void) #c_call;
Proc_GetInstanceProcAddrLUNARG :: #type (instance: Instance, pName: *u8) -> Proc_VoidFunction #c_call;

// --------------------------------------------------------------------------
// Structs and unions
// --------------------------------------------------------------------------

// sType is pre-initialised to the right StructureType, so a plain
// `info: ImageCreateInfo;` is already tagged correctly.

// BaseOutStructure (VkBaseOutStructure) -- https://registry.khronos.org/vulkan/specs/latest/man/html/VkBaseOutStructure.html
BaseOutStructure :: struct {
    sType : StructureType;
    pNext : *BaseOutStructure;
}

// BaseInStructure (VkBaseInStructure) -- https://registry.khronos.org/vulkan/specs/latest/man/html/VkBaseInStructure.html
BaseInStructure :: struct {
    sType : StructureType;
    pNext : *BaseInStructure;
}

// Offset2D (VkOffset2D) -- https://registry.khronos.org/vulkan/specs/latest/man/html/VkOffset2D.html
Offset2D :: struct {
    x : s32;
    y : s32;
}

// Offset3D (VkOffset3D) -- https://registry.khronos.org/vulkan/specs/latest/man/html/VkOffset3D.html
Offset3D :: struct {
    x : s32;
    y : s32;
    z : s32;
}

// Extent2D (VkExtent2D) -- https://registry.khronos.org/vulkan/specs/latest/man/html/VkExtent2D.html
Extent2D :: struct {
    width : u32;
    height : u32;
}

// Extent3D (VkExtent3D) -- https://registry.khronos.org/vulkan/specs/latest/man/html/VkExtent3D.html
Extent3D :: struct {
    width : u32;
    height : u32;
    depth : u32;
}

// Viewport (VkViewport) -- https://registry.khronos.org/vulkan/specs/latest/man/html/VkViewport.html
Viewport :: struct {
    x : float32;
    y : float32;
    width : float32;
    height : float32;
    minDepth : float32;
    maxDepth : float32;
}

// Rect2D (VkRect2D) -- https://registry.khronos.org/vulkan/specs/latest/man/html/VkRect2D.html
Rect2D :: struct {
    offset : Offset2D;
