//
// emit.jai -- turns a Registry into the Jai module.
//
// Names are Jai-native: the Vk/vk/VK_ prefixes come off (see names.jai), because the module
// is meant to be imported under a name. Comments keep the C spelling next to the Jai one so
// the registry and the specification stay easy to cross-reference.
//

// The registry being emitted, for the few places that are reached through emit_guarded's
// single-item callback and still need to look something up.
current_registry: *Registry;

emit_module :: (vk: *Registry, video: *Registry, out_dir: string) {
    current_registry   = vk;
    active_vendor_tags = vk.vendor_tags;

    // Claim the names we write by hand before anything generated can collide with them.
    for PLATFORM_TYPES     reserve_name(it.name);
    for LOADER_API_RENAMES record_name(it.jai, it.c);

    module_text   := emit_module_file(vk, video != null);
    platform_text := emit_platform_file(vk);
    types_text    := emit_types_file(vk);
    loader_text   := emit_loader_file(vk);
    video_text: string;
    if video {
        current_registry = video;
        video_text = emit_video_file(video);
        current_registry = vk;
    }

    // Every rename is known now, so the mapper and the migration data can be written.
    c_names_text   := emit_c_names_file(vk);
    migration_text := emit_migration_names_file(vk);

    if name_collisions {
        log_error("% naming problem(s); not writing the module.", name_collisions);
        exit(1);
    }

    write_generated(out_dir, "module.jai",          module_text);
    write_generated(out_dir, "vulkan_platform.jai", platform_text);
    write_generated(out_dir, "vulkan_types.jai",    types_text);
    write_generated(out_dir, "vulkan_loader.jai",   loader_text);
    if video  write_generated(out_dir, "vulkan_video.jai", video_text);

    c_names_dir := join(out_dir, "/C_Names");
    if !make_directory_if_it_does_not_exist(c_names_dir) {
        log_error("Could not create '%'.", c_names_dir);
        exit(1);
    }
    write_generated(c_names_dir, "module.jai", c_names_text);

    log("  % names renamed from their C spelling", renames.count);
}

write_generated :: (dir: string, name: string, contents: string) {
    path := join(dir, "/", name);
    if !write_entire_file(path, contents) {
        log_error("Could not write '%'.", path);
        exit(1);
    }
    log("  wrote % (% KiB)", path, (contents.count + 1023) / 1024);
}

banner :: (builder: *String_Builder, reg: *Registry, title: string) {
    print_to_builder(builder, "//\n// %\n//\n", title);
    append(builder, "// Generated by Jolk's generator from the Vulkan registry. Do not edit by hand:\n");
    append(builder, "// re-run the generator in generator/ instead.\n");
    if reg.header_version  print_to_builder(builder, "//\n// Vulkan header version: %\n", reg.header_version);
    append(builder, "//\n\n");
}

// "ImageLayout (VkImageLayout)" when the names differ, so a grep for either finds it.
both_names :: (jai_name: string, c_name: string) -> string {
    if jai_name == c_name  return jai_name;
    return tprint("% (%)", jai_name, c_name);
}

// ------------------------------------------------------------------------------------
// Identifiers
// ------------------------------------------------------------------------------------

// Vulkan member and parameter names that happen to be Jai keywords or builtin type names.
// We give them a trailing underscore, the same thing the C++ bindings do with `type`.
RESERVED_IDENTIFIERS :: string.[
    "void", "bool", "string", "int", "float", "float32", "float64",
    "s8", "s16", "s32", "s64", "u8", "u16", "u32", "u64",
    "Type", "Any", "Code", "context", "it", "it_index",
    "if", "ifx", "then", "else", "for", "while", "break", "continue", "return",
    "struct", "enum", "enum_flags", "union", "using", "defer", "cast", "xx",
    "null", "true", "false", "inline", "operator", "case", "remove", "push_context",
    "size_of", "type_of", "type_info", "interface", "new", "delete",
];

safe_identifier :: (name: string) -> string {
    for RESERVED_IDENTIFIERS  if it == name  return tprint("%_", name);
    return name;
}

// ------------------------------------------------------------------------------------
// Guard grouping
//
// Rather than wrapping every declaration in its own #if, we emit everything unguarded
// first and then one block per distinct guard. `emit_one` does the work for a single item.
// ------------------------------------------------------------------------------------

emit_guarded :: (builder: *String_Builder, items: [] $T, emit_one: (*String_Builder, T)) {
    for items  if !guard_of(it)  emit_one(builder, it);

    guards: [..] string;
    defer array_free(guards);

    for items {
        guard := guard_of(it);
        if !guard  continue;
        seen := false;
        for guards  if it == guard { seen = true; break; }
        if !seen  array_add(*guards, guard);
    }

    for guard: guards {
        print_to_builder(builder, "#if % {\n\n", guard);
        for items  if guard_of(it) == guard  emit_one(builder, it);
        print_to_builder(builder, "} // %\n\n", guard);
    }
}

guard_of :: (t: *Reg_Type)    -> string { return t.guard; }
guard_of :: (g: *Enum_Group)  -> string { return g.guard; }
guard_of :: (c: *Command)     -> string { return c.guard; }

required_types :: (reg: *Registry, category: Type_Category) -> [] *Reg_Type {
    result: [..] *Reg_Type;
    for reg.types  if it.required && it.category == category  array_add(*result, it);
    return result;
}

// ------------------------------------------------------------------------------------
// module.jai
// ------------------------------------------------------------------------------------

emit_module_file :: (reg: *Registry, with_video: bool) -> string {
    builder: String_Builder;
    banner(*builder, reg, "Jolk -- Vulkan for Jai");

    append(*builder, #string TEXT
// Import it under a name; everything in here is spelled without the C prefixes:
//
//     Vk :: #import "Jolk";
//
//     info: Vk.ImageCreateInfo;
//     info.initialLayout = .UNDEFINED;
//     Vk.CreateImage(device, *info, null, *image);
//
// For the C spellings (VkImageCreateInfo, vkCreateImage), import it through Jolk/C_Names;
// see that module for how.
//
// Platform parameters. Each one matches the VK_USE_PLATFORM_* macro of the same name in
// the C headers, and turning one on adds that window system's types, structs and commands.
// Unlike the C headers you can have several on at once, which is what you want on Linux.
//
//     Vk :: #import "Jolk"(VK_USE_PLATFORM_WAYLAND_KHR = true);
//
// Import Jolk with the same parameters everywhere in a program. Each distinct set of
// parameters is a separate instance of the module, with its own types and its own loaded
// entry points, and they do not interoperate.
//
TEXT);

    append(*builder, "#module_parameters (\n");

    // Every platform the registry knows about, defaulted to the ones that make sense here.
    platforms: [..] string;
    for reg.extensions {
        if !it.platform  continue;
        protect := guard_for_extension(reg, it);
        if !protect  continue;
        seen := false;
        for platforms  if it == protect { seen = true; break; }
        if !seen  array_add(*platforms, protect);
    }
    quick_sort(platforms, compare_strings);

    longest := 0;
    for platforms  if it.count > longest  longest = it.count;

    for platforms {
        print_to_builder(*builder, "    %", it);
        for 1..longest - it.count  append(*builder, " ");
        print_to_builder(*builder, " := %", default_for_platform(it));
        if it_index != platforms.count - 1  append(*builder, ",");   // no trailing comma
        append(*builder, "\n");
    }
    append(*builder, ");\n\n");

    append(*builder, "#load \"vulkan_platform.jai\";   // window-system types the platform extensions refer to\n");
    append(*builder, "#load \"vulkan_types.jai\";      // handles, enums, constants, structs and unions\n");
    if with_video {
        append(*builder, "#load \"vulkan_video.jai\";      // the StdVideo* types the video extensions use\n");
    }
    append(*builder, "#load \"vulkan_loader.jai\";     // the volk-style entry-point loader\n");

    append(*builder, #string TEXT

// Jolk imports nothing. The loader opens the Vulkan library through the OS directly, so
// this module adds no dependencies and nothing to link against.
TEXT);

    return builder_to_string(*builder);
}

// Which platforms are on by default: the ones whose window system this OS actually has.
// Everything else (and anything provisional) is opt-in.
default_for_platform :: (protect: string) -> string {
    if protect == "VK_USE_PLATFORM_WIN32_KHR"    return "OS == .WINDOWS";
    if protect == "VK_USE_PLATFORM_XLIB_KHR"     return "OS == .LINUX";
    if protect == "VK_USE_PLATFORM_XCB_KHR"      return "OS == .LINUX";
    if protect == "VK_USE_PLATFORM_WAYLAND_KHR"  return "OS == .LINUX";
    if protect == "VK_USE_PLATFORM_METAL_EXT"    return "OS == .MACOS";
    if protect == "VK_USE_PLATFORM_MACOS_MVK"    return "OS == .MACOS";
    if protect == "VK_USE_PLATFORM_ANDROID_KHR"  return "OS == .ANDROID";
    return "false";
}

// ------------------------------------------------------------------------------------
// vulkan_platform.jai
// ------------------------------------------------------------------------------------

// Types that come from a window system header rather than from Vulkan. The registry only
// names them, so we have to supply the Jai spelling. They are laid out to match the real
// headers, so a HWND from the Windows module passes straight into Win32SurfaceCreateInfoKHR.
// They keep their own names: they are not Vulkan's to rename.
Platform_Type :: struct {
    name       : string;
    definition : string;
}

PLATFORM_TYPES :: Platform_Type.[
    // Win32
    .{"HINSTANCE",           "HINSTANCE :: *void;"},
    .{"HWND",                "HWND      :: *void;"},
    .{"HMONITOR",            "HMONITOR  :: *void;"},
    .{"HANDLE",              "HANDLE    :: *void;"},
    .{"DWORD",               "DWORD     :: u32;"},
    .{"LPCWSTR",             "LPCWSTR   :: *u16;"},
    .{"SECURITY_ATTRIBUTES", "SECURITY_ATTRIBUTES :: struct {\n    nLength              : u32;\n    lpSecurityDescriptor : *void;\n    bInheritHandle       : s32;\n}"},

    // Xlib / XCB / Wayland / DirectFB
    .{"Display",             "Display :: struct {}"},
    .{"VisualID",            "VisualID :: u64;"},
    .{"Window",              "Window   :: u64;"},
    .{"RROutput",            "RROutput :: u64;"},
    .{"xcb_connection_t",    "xcb_connection_t :: struct {}"},
    .{"xcb_visualid_t",      "xcb_visualid_t   :: u32;"},
    .{"xcb_window_t",        "xcb_window_t     :: u32;"},
    .{"wl_display",          "wl_display :: struct {}"},
    .{"wl_surface",          "wl_surface :: struct {}"},
    .{"IDirectFB",           "IDirectFB        :: struct {}"},
    .{"IDirectFBSurface",    "IDirectFBSurface :: struct {}"},

    // Android
    .{"ANativeWindow",       "ANativeWindow   :: struct {}"},
    .{"AHardwareBuffer",     "AHardwareBuffer :: struct {}"},

    // Apple / Metal. These are Objective-C object pointers, which are opaque to us.
    .{"CAMetalLayer",        "CAMetalLayer :: struct {}"},
    .{"MTLDevice_id",        "MTLDevice_id       :: *void;"},
    .{"MTLCommandQueue_id",  "MTLCommandQueue_id :: *void;"},
    .{"MTLBuffer_id",        "MTLBuffer_id       :: *void;"},
    .{"MTLTexture_id",       "MTLTexture_id      :: *void;"},
    .{"MTLSharedEvent_id",   "MTLSharedEvent_id  :: *void;"},
    .{"IOSurfaceRef",        "IOSurfaceRef       :: *void;"},

    // Fuchsia, GGP, QNX Screen, NVIDIA SCI, Nintendo Vi, Open Harmony, UBM
    .{"zx_handle_t",          "zx_handle_t :: u32;"},
    .{"GgpStreamDescriptor",  "GgpStreamDescriptor :: u32;"},
    .{"GgpFrameToken",        "GgpFrameToken       :: u64;"},
    .{"_screen_context",      "_screen_context :: struct {}"},
    .{"_screen_window",       "_screen_window  :: struct {}"},
    .{"_screen_buffer",       "_screen_buffer  :: struct {}"},
    .{"NvSciSyncAttrList",    "NvSciSyncAttrList :: *void;"},
    .{"NvSciSyncObj",         "NvSciSyncObj      :: *void;"},
    .{"NvSciSyncFence",       "NvSciSyncFence    :: struct { payload: [6] u64; }"},
    .{"NvSciBufAttrList",     "NvSciBufAttrList  :: *void;"},
    .{"NvSciBufObj",          "NvSciBufObj       :: *void;"},
    .{"OHNativeWindow",       "OHNativeWindow  :: struct {}"},
    .{"OHBufferHandle",       "OHBufferHandle  :: struct {}"},
    .{"OH_NativeBuffer",      "OH_NativeBuffer :: struct {}"},
    .{"ubm_device",           "ubm_device  :: struct {}"},
    .{"ubm_surface",          "ubm_surface :: struct {}"},
];

emit_platform_file :: (reg: *Registry) -> string {
    builder: String_Builder;
    banner(*builder, reg, "Window-system types referred to by the platform extensions");

    append(*builder, #string TEXT
// These stand in for types that really belong to a window-system header. Each is laid out
// to match the real one, so values pass back and forth with (for instance) Jai's Windows
// module without a cast.
//
// Everything here sits behind the platform parameter that needs it, so a build with no
// platform extensions turned on declares none of them.

TEXT);

    // Emit only the ones the API surface actually reaches, under the same guard as the
    // extensions that need them: a Windows build has no business declaring X11's `Window`.
    // The PLATFORM_TYPES order is preserved within each guard so related types stay together.
    emitted: Table(string, bool);
    definitions: Table(string, string);
    needed: [..] *Reg_Type;

    for entry: PLATFORM_TYPES {
        found := table_find_pointer(*reg.type_by_name, entry.name);
        if !found || !found.*.required  continue;
        array_add(*needed, found.*);
        table_set(*definitions, entry.name, entry.definition);
        table_set(*emitted, entry.name, true);
    }

    platform_definitions = *definitions;
    emit_guarded(*builder, needed, emit_platform_type);
    platform_definitions = null;

    // Warn loudly if the registry grew an external type we have no spelling for, rather
    // than quietly emitting a module that will not compile. C scalars are handled by the
    // type mapping, and the StdVideo* types come from video.xml, so neither is missing.
    for reg.types {
        if !it.required || it.category != .EXTERNAL  continue;
        if table_find_pointer(*emitted, it.name)  continue;
        _, is_scalar := c_to_jai_scalar(it.name);
        if is_scalar                      continue;
        if starts_with(it.name, "StdVideo")  continue;
        log_error("No Jai spelling for the external type '%' (required by %). Add it to PLATFORM_TYPES in emit.jai.",
                  it.name, it.provider);
    }

    return builder_to_string(*builder);
}

// emit_guarded hands the callback one item at a time, so the lookup table has to reach it
// some other way. The generator is single-threaded and this is set for one call only.
platform_definitions: *Table(string, string);

emit_platform_type :: (builder: *String_Builder, t: *Reg_Type) {
    definition := table_find_pointer(platform_definitions, t.name);
    if !definition  return;
    print_to_builder(builder, "%\n", definition.*);
}

// True when we supply this type ourselves rather than generating it from the registry.
is_platform_type :: (name: string) -> bool {
    for PLATFORM_TYPES  if it.name == name  return true;
    return false;
}

// ------------------------------------------------------------------------------------
// vulkan_types.jai
// ------------------------------------------------------------------------------------

emit_types_file :: (reg: *Registry) -> string {
    builder: String_Builder;
    banner(*builder, reg, "Vulkan types, constants and enumerations");

    emit_version_macros(*builder, reg);
    emit_base_types(*builder, reg);
    emit_api_constants(*builder, reg);
    emit_extension_constants(*builder, reg);
    emit_handles(*builder, reg);
    emit_enum_groups(*builder, reg);
    emit_bitmask_aliases(*builder, reg);
    emit_funcpointers(*builder, reg);
    emit_structs(*builder, reg);

    return builder_to_string(*builder);
}

emit_version_macros :: (builder: *String_Builder, reg: *Registry) {
    section(builder, "Version numbers");

    for string.["VK_MAKE_API_VERSION", "VK_API_VERSION_VARIANT", "VK_API_VERSION_MAJOR",
                "VK_API_VERSION_MINOR", "VK_API_VERSION_PATCH", "VK_NULL_HANDLE"] {
        record_name(constant_name(it), it);
    }

    append(builder, #string TEXT
MAKE_API_VERSION :: inline (variant: u32, major: u32, minor: u32, patch: u32) -> u32 {
    return (variant << 29) | (major << 22) | (minor << 12) | patch;
}

API_VERSION_VARIANT :: inline (version: u32) -> u32 { return version >> 29; }
API_VERSION_MAJOR   :: inline (version: u32) -> u32 { return (version >> 22) & 0x7F; }
API_VERSION_MINOR   :: inline (version: u32) -> u32 { return (version >> 12) & 0x3FF; }
API_VERSION_PATCH   :: inline (version: u32) -> u32 { return version & 0xFFF; }

NULL_HANDLE :: null;

TEXT);

    // The registry's version defines are #define VK_API_VERSION_1_2 VK_MAKE_API_VERSION(0, 1, 2, 0),
    // so pick them out by name and re-derive the numbers.
    for reg.types {
        if it.category != .DEFINE  continue;
        if !starts_with(it.name, "VK_API_VERSION_1_")  continue;
        digits := slice(it.name, "VK_API_VERSION_1_".count, it.name.count - "VK_API_VERSION_1_".count);
        print_to_builder(builder, "% :: #run MAKE_API_VERSION(0, 1, %, 0);\n",
                         record_name(constant_name(it.name), it.name), digits);
    }

    if reg.header_version {
        record_name("HEADER_VERSION", "VK_HEADER_VERSION");
        record_name("HEADER_VERSION_COMPLETE", "VK_HEADER_VERSION_COMPLETE");
        print_to_builder(builder, "\nHEADER_VERSION :: %;\n", reg.header_version);
        print_to_builder(builder, "HEADER_VERSION_COMPLETE :: #run MAKE_API_VERSION(0, 1, %, HEADER_VERSION);\n",
                         latest_minor_version(reg));
    }
    append(builder, "\n");
}

latest_minor_version :: (reg: *Registry) -> string {
    best := "0";
    for reg.types {
        if it.category != .DEFINE  continue;
        if !starts_with(it.name, "VK_API_VERSION_1_")  continue;
        digits := slice(it.name, "VK_API_VERSION_1_".count, it.name.count - "VK_API_VERSION_1_".count);
        a, a_ok := string_to_int(digits);
        b, b_ok := string_to_int(best);
        if a_ok && b_ok && a > b  best = digits;
    }
    return best;
}

section :: (builder: *String_Builder, title: string) {
    append(builder, "\n// ");
    for 1..74  append(builder, "-");
    print_to_builder(builder, "\n// %\n// ", title);
    for 1..74  append(builder, "-");
    append(builder, "\n\n");
}

emit_base_types :: (builder: *String_Builder, reg: *Registry) {
    section(builder, "Base types");

    for reg.types {
        if !it.required || it.category != .BASETYPE  continue;
        if is_platform_type(it.name)  continue;

        name := record_name(type_name(it.name), it.name);

        underlying := it.return_decl;
        if !underlying.base_type || underlying.base_type == "void" {
            if underlying.pointer_depth {
                print_to_builder(builder, "% :: *void;\n", name);
            } else {
                // An opaque `struct Foo;` forward declaration: we only ever see pointers to it.
                print_to_builder(builder, "% :: struct {}\n", name);
            }
            continue;
        }
        print_to_builder(builder, "% :: %;\n", name, jai_type(underlying));
    }
    append(builder, "\n");
}

emit_api_constants :: (builder: *String_Builder, reg: *Registry) {
    if !reg.constants  return;
    section(builder, "API constants");

    for reg.constants.values  emit_constant(builder, it);
    append(builder, "\n");
}

emit_constant :: (builder: *String_Builder, value: Enum_Value) {
    name := record_name(constant_name(value.name), value.name);

    if value.kind == .ALIAS {
        print_to_builder(builder, "% :: %;\n", name, constant_name(value.alias));
        return;
    }

    literal := jai_literal(value.value);
    comment := ifx value.comment then tprint("   // %", value.comment) else "";

    // Some constants are defined as another constant (video.xml's *_SPEC_VERSION is its
    // *_API_VERSION_1_0_0), and that name has to follow the rename too.
    if is_identifier(literal)  literal = constant_name(literal);

    // Plain counts stay untyped so they can be used as array lengths; the sentinel values
    // (~0U and friends) keep their C type so comparisons against them do not go signed.
    is_float := contains(literal, #char ".");
    if is_plain_integer(value.value) || is_float || !value.type_name {
        print_to_builder(builder, "% :: %;%\n", name, literal, comment);
    } else {
        base_type, ok := c_to_jai_scalar(value.type_name);
        assert(ok, "Could not find a Jai equivalent to C type %", value.type_name);
        print_to_builder(builder, "% : % : %;%\n", name, base_type, literal, comment);
    }
}

is_identifier :: (text: string) -> bool {
    if !text  return false;
    first := text[0];
    if !(is_upper_ascii(first) || is_lower_ascii(first) || first == #char "_")  return false;
    for 0..text.count-1 {
        c := text[it];
        if !(is_upper_ascii(c) || is_lower_ascii(c) || is_digit_ascii(c) || c == #char "_")  return false;
    }
    return true;
}

emit_extension_constants :: (builder: *String_Builder, reg: *Registry) {
    section(builder, "Extension names and versions");

    append(builder, "// The *_EXTENSION_NAME constants are Jai strings. Pass `.data` where Vulkan wants\n");
    append(builder, "// a *u8 -- string literals are zero-terminated, so the pointer is a valid C string.\n\n");

    emit_unique_constants(builder, reg);
}

// Constants declared by extensions rather than in the API Constants block. The same name
// can be declared by several extensions, so emit each one once.
emit_unique_constants :: (builder: *String_Builder, reg: *Registry) {
    emitted: Table(string, bool);
    for reg.ext_constants {
        if table_find_pointer(*emitted, it.name)  continue;
        table_set(*emitted, it.name, true);
        emit_constant(builder, it);
    }
    append(builder, "\n");
}

emit_handles :: (builder: *String_Builder, reg: *Registry) {
    section(builder, "Handles");

    append(builder, "// Each handle is a pointer to its own opaque struct, exactly as in the C headers, so\n");
    append(builder, "// the compiler will not let you pass a Buffer where an Image belongs. NULL_HANDLE\n");
    append(builder, "// is null.\n\n");

    handles := required_types(reg, .HANDLE);
    emit_guarded(builder, handles, emit_handle);
}

emit_handle :: (builder: *String_Builder, t: *Reg_Type) {
    name := record_name(type_name(t.name), t.name);
    if t.alias {
        print_to_builder(builder, "% :: %;\n", name, type_name(t.alias));
        return;
    }
    opaque := record_name(tprint("%_T", name), tprint("%_T", t.name));
    kind := ifx t.is_dispatchable then "dispatchable" else "non-dispatchable";
    print_to_builder(builder, "% :: struct {}\n", opaque);
    print_to_builder(builder, "% :: *%;   // %\n", name, opaque, kind);
}

emit_enum_groups :: (builder: *String_Builder, reg: *Registry) {
    section(builder, "Enumerations");

    append(builder, "// Values are named without their type's prefix: ImageLayout.GENERAL, or .GENERAL\n");
    append(builder, "// wherever the type is already known. VK_IMAGE_LAYOUT_GENERAL in C.\n\n");

    groups: [..] *Enum_Group;
    for reg.groups  if it.required  array_add(*groups, it);
    emit_guarded(builder, groups, emit_enum_group);

    // An enum promoted from an extension into core keeps its old name as an alias --
    // VkAccelerationStructureTypeNV for VkAccelerationStructureTypeKHR, say. Those are
    // type declarations rather than value groups, so they come from reg.types.
    append(builder, "// Enum types renamed by promotion; each is the same type under its older name.\n");
    aliases: [..] *Reg_Type;
    for reg.types  if it.required && it.category == .ENUM && it.alias  array_add(*aliases, it);
    emit_guarded(builder, aliases, emit_type_alias);
}

emit_type_alias :: (builder: *String_Builder, t: *Reg_Type) {
    print_to_builder(builder, "% :: %;\n", record_name(type_name(t.name), t.name), type_name(t.alias));
}

// The vendor tag list the current registry provides; emit_enum_group is reached through
// emit_guarded's callback, which cannot carry extra arguments.
active_vendor_tags: [] string;

emit_enum_group :: (builder: *String_Builder, group: *Enum_Group) {
    name := record_name(type_name(group.name), group.name);
    print_to_builder(builder, "// % -- %\n", both_names(name, group.name), docs_link(group.name));

    if group.kind == .BITMASK {
        print_to_builder(builder, "% :: enum_flags u% #specified {\n", name, group.bitwidth);
    } else {
        print_to_builder(builder, "% :: enum s32 #specified {\n", name);
    }

    short_names := shorten_enum_values(group, active_vendor_tags);

    // Concrete values first, then aliases, so an alias always refers to a name the
    // compiler has already seen inside this enum body.
    for group.values  if it.kind != .ALIAS  emit_enum_value(builder, group, it, short_names[it_index]);

    wrote_alias_header := false;
    for group.values {
        if it.kind != .ALIAS  continue;
        if !it.alias          continue;
        if !wrote_alias_header {
            append(builder, "\n    // Aliases (promoted or renamed by a later version or extension).\n");
            wrote_alias_header = true;
        }

        target := it.alias;
        index  := table_find_pointer(*group.by_name, it.alias);
        if index  target = short_names[index.*];
        print_to_builder(builder, "    % :: %;\n", short_names[it_index], target);
    }

    append(builder, "}\n\n");

    for group.values {
        if it.kind == .ALIAS && !it.alias  continue;   // dropped above, so not in the enum
        record_enum_value(it.name, name, short_names[it_index]);
    }
}

// Works out the short name for every value in a group, returning one entry per value in
// the same order. An entry equal to the value's own name means "keeps the C spelling".
shorten_enum_values :: (group: *Enum_Group, vendor_tags: [] string) -> [] string {
    if group.short_names.count  return group.short_names;   // computed once per group

    prefix := derive_enum_prefix(group.name, vendor_tags);

    // A few groups do not follow their own type name: VkResult's values are VK_SUCCESS and
    // VK_ERROR_*, never VK_RESULT_*. When the derived prefix matches almost nothing, fall
    // back to the bare namespace prefix.
    matches := 0;
    for group.values {
        _, ok := strip_enum_prefix(it.name, prefix);
        if ok  matches += 1;
    }
    if group.values.count && matches * 2 < group.values.count {
        prefix = ifx starts_with(group.name, "Std") then "STD" else "VK";
    }

    taken: Table(string, bool);
    for group.values  table_set(*taken, it.name, true);

    result := NewArray(group.values.count, string);
    for group.values {
        short, ok := strip_enum_prefix(it.name, prefix);

        // Two values in one group must not shorten to the same identifier, and a short name
        // must not collide with some other value's full name.
        if !ok || table_find_pointer(*taken, short) {
            result[it_index] = it.name;
            continue;
        }

        table_set(*taken, short, true);
        result[it_index] = short;
    }

    group.short_names = result;
    return result;
}

// The short name of one value, looked up by its C name. Used for sType defaults.
short_enum_value :: (group_c_name: string, value_c_name: string) -> string, bool {
    group := table_find_pointer(*current_registry.group_by_name, group_c_name);
    if !group  return value_c_name, false;

    index := table_find_pointer(*group.*.by_name, value_c_name);
    if !index  return value_c_name, false;

    shorts := shorten_enum_values(group.*, active_vendor_tags);
    return shorts[index.*], true;
}

emit_enum_value :: (builder: *String_Builder, group: *Enum_Group, value: Enum_Value, short_name: string) {
    literal: string;
    if value.kind == .BITPOS {
        digits := ifx group.bitwidth == 64 then 16 else 8;
        bit    := (cast(u64) 1) << (cast(u64) value.numeric);
        literal = tprint("0x%", formatInt(bit, base = 16, minimum_digits = digits));
    } else if value.has_numeric {
        literal = tprint("%", value.numeric);
    } else {
        literal = jai_literal(value.value);
    }

    print_to_builder(builder, "    % :: %;", short_name, literal);
    if value.comment  print_to_builder(builder, "   // %", value.comment);
    append(builder, "\n");
}

emit_bitmask_aliases :: (builder: *String_Builder, reg: *Registry) {
    section(builder, "Flag types");

    append(builder, "// FooFlags is an alias of FooFlagBits, so you can assign and or-together flag values\n");
    append(builder, "// without casting. Flag types with no bits defined yet fall back to Flags.\n\n");

    bitmasks := required_types(reg, .BITMASK);
    emit_guarded(builder, bitmasks, emit_bitmask);
}

emit_bitmask :: (builder: *String_Builder, t: *Reg_Type) {
    name := record_name(type_name(t.name), t.name);
    if t.alias {
        print_to_builder(builder, "% :: %;\n", name, type_name(t.alias));
        return;
    }
    if t.flag_bits {
        print_to_builder(builder, "% :: %;\n", name, type_name(t.flag_bits));
        return;
    }
    print_to_builder(builder, "% :: %;\n", name, type_name(ifx t.bitwidth == 64 then "VkFlags64" else "VkFlags"));
}

emit_funcpointers :: (builder: *String_Builder, reg: *Registry) {
    section(builder, "Callback types");

    append(builder, "// These are called by the driver, so they are #c_call and get no Jai context. Use\n");
    append(builder, "// `push_context` inside one before calling anything that needs a context.\n\n");

    funcpointers := required_types(reg, .FUNCPOINTER);
    emit_guarded(builder, funcpointers, emit_funcpointer);
}

emit_funcpointer :: (builder: *String_Builder, t: *Reg_Type) {
    name := record_name(type_name(t.name), t.name);
    print_to_builder(builder, "% :: #type (", name);
    for t.params {
        if it_index  append(builder, ", ");
        print_to_builder(builder, "%: %", safe_identifier(it.name), jai_param_type(it));
    }
    append(builder, ")");

    return_type := jai_type(t.return_decl);
    if return_type != "void"  print_to_builder(builder, " -> %", return_type);
    append(builder, " #c_call;\n");
}

// ------------------------------------------------------------------------------------
// Structs and unions
// ------------------------------------------------------------------------------------

emit_structs :: (builder: *String_Builder, reg: *Registry) {
    section(builder, "Structs and unions");

    append(builder, "// sType is pre-initialised to the right StructureType, so a plain\n");
    append(builder, "// `info: ImageCreateInfo;` is already tagged correctly.\n\n");

    aggregates: [..] *Reg_Type;
    for reg.types {
        if !it.required  continue;
        if it.category != .STRUCT && it.category != .UNION  continue;
        array_add(*aggregates, it);
    }
    emit_guarded(builder, aggregates, emit_aggregate);
}

emit_aggregate :: (builder: *String_Builder, t: *Reg_Type) {
    name := record_name(type_name(t.name), t.name);
    if t.alias {
        print_to_builder(builder, "% :: %;\n\n", name, type_name(t.alias));
        return;
    }

    print_to_builder(builder, "// % -- %\n", both_names(name, t.name), docs_link(t.name));
    if t.structextends {
        extends := split(t.structextends, ",");
        for * extends  it.* = type_name(it.*);
        print_to_builder(builder, "// Goes in the pNext chain of: %\n", join(..extends, separator = ", "));
    }
    if t.returnedonly {
        append(builder, "// Filled in by Vulkan; you do not set it up yourself.\n");
    }

    keyword := ifx t.category == .UNION then "union" else "struct";
    print_to_builder(builder, "% :: % {\n", name, keyword);

    units := emit_struct_members(builder, t);
    append(builder, "}\n\n");

    for units {
        emit_bitfield_accessors(builder, name, it);
        record_bitfield(t.name, it.fields[0].name, it.storage_name);
    }
}

Bitfield_Field :: struct {
    name         : string;
    declared_type: string;   // what the registry says, which may be a flags enum
    offset       : int;
    width        : int;
}

Bitfield_Unit :: struct {
    storage_name : string;
    storage_type : string;   // u32 / u64 / ...
    member_index : int;      // where in t.members this unit starts
    fields       : [..] Bitfield_Field;
}

// Groups the struct's C bit-fields into storage units the way a C compiler would: bits
// accumulate into one integer of the declared type until the next field would not fit, or
// until the declared type changes.
plan_bitfields :: (t: *Reg_Type) -> [..] Bitfield_Unit {
    units: [..] Bitfield_Unit;
    current: *Bitfield_Unit;
    used_bits := 0;

    for * member, index: t.members {
        if member.bitfield_width <= 0 {
            current   = null;
            used_bits = 0;
            continue;
        }

        storage := bitfield_storage_type(member.base_type);
        capacity := bitfield_storage_width(storage);

        if !current || current.storage_type != storage || used_bits + member.bitfield_width > capacity {
            array_add(*units, .{});
            current = *units[units.count - 1];
            // Named the way Jai's own Bindings_Generator names them, so a reader who has
            // seen other generated bindings recognises the shape.
            current.storage_name = ifx units.count == 1 then "__bitfield" else tprint("__bitfield_%", units.count - 1);
            current.storage_type = storage;
            current.member_index = index;
            used_bits = 0;
        }

        field: Bitfield_Field;
        field.name          = member.name;
        field.declared_type = jai_type_name(member.base_type);
        field.offset        = used_bits;
        field.width         = member.bitfield_width;
        array_add(*current.fields, field);

        used_bits += member.bitfield_width;
    }

    return units;
}

// Writes the members, substituting each run of C bit-fields with the integer it packs into
// plus a comment describing the packing, and returns the units so we can emit accessors.
emit_struct_members :: (builder: *String_Builder, t: *Reg_Type) -> [] Bitfield_Unit {
    units := plan_bitfields(t);

    for * member, index: t.members {
        if member.bitfield_width <= 0 {
            emit_member(builder, member);
            continue;
        }

        // Only write the storage integer once, at the member the unit starts on.
        for * unit: units {
            if unit.member_index != index  continue;

            print_to_builder(builder, "    % : %;\n", unit.storage_name, unit.storage_type);
            append(builder, "    /*\n");
            for field: unit.fields {
                print_to_builder(builder, "        %: % /* % bits */\n",
                                 field.name, field.declared_type, field.width);
            }
            append(builder, "    */\n");
        }
    }

    return units;
}

emit_member :: (builder: *String_Builder, member: *Decl) {
    print_to_builder(builder, "    % : %", safe_identifier(member.name), jai_type(member));

    // sType gets its structure-type value as a default. A member that lists several
    // possible values has no single right default, so it gets none.
    if member.values && !contains(member.values, #char ",") {
        short, found := short_enum_value(member.base_type, member.values);
        if found  print_to_builder(builder, " = .%", short);
    }
    append(builder, ";");
    if member.comment  print_to_builder(builder, "   // %", member.comment);
    append(builder, "\n");
}

bitfield_storage_type :: (c_type: string) -> string {
    mapped, is_scalar := c_to_jai_scalar(c_type);
    if is_scalar  return mapped;
    return "u32";   // a flags enum used as a bit-field; all of those are 32 bits wide
}

bitfield_storage_width :: (storage: string) -> int {
    if storage == "u8"  || storage == "s8"   return 8;
    if storage == "u16" || storage == "s16"  return 16;
    if storage == "u64" || storage == "s64"  return 64;
    return 32;
}

// Jai has no bit-fields, so each packed field gets a get_/set_ pair overloaded on the
// struct type. The naming follows Jai's Bindings_Generator, which does the same thing for
// C bit-fields in every other generated binding in the ecosystem.
//
// A one-bit field is exposed as a bool, which is what it always means in practice -- most
// of the StdVideo* structs are nothing but one-bit flags.
emit_bitfield_accessors :: (builder: *String_Builder, struct_name: string, unit: Bitfield_Unit) {
    storage := unit.storage_type;

    for field: unit.fields {
        name      := safe_identifier(field.name);
        is_flag   := field.width == 1;
        value_type := ifx is_flag then "bool" else field.declared_type;

        // The mask is written in place, already shifted, so both accessors can use it.
        mask      := bit_mask(field.width) << (cast(u64) field.offset);
        mask_text := tprint("0x%", formatInt(mask, base = 16));

        if is_flag {
            print_to_builder(builder, "get_% :: inline (fields: %) -> bool {\n", name, struct_name);
            print_to_builder(builder, "    return (fields.% & %) != 0;\n", unit.storage_name, mask_text);
            append(builder, "}\n");

            print_to_builder(builder, "set_% :: inline (fields: *%, value: bool) {\n", name, struct_name);
            print_to_builder(builder, "    if value  fields.% |= %;\n", unit.storage_name, mask_text);
            print_to_builder(builder, "    else      fields.% &= ~cast(%) %;\n", unit.storage_name, storage, mask_text);
            append(builder, "}\n");
        } else {
            print_to_builder(builder, "get_% :: inline (fields: %) -> % {\n", name, struct_name, value_type);
            print_to_builder(builder, "    return cast,no_check(%) ((fields.% & %) >> %);\n",
                             value_type, unit.storage_name, mask_text, field.offset);
            append(builder, "}\n");

            print_to_builder(builder, "set_% :: inline (fields: *%, value: %) {\n", name, struct_name, value_type);
            print_to_builder(builder, "    MASK : % : %;\n", storage, mask_text);
            print_to_builder(builder, "    fields.% = (fields.% & ~MASK) | (((cast,no_check(%) value) << %) & MASK);\n",
                             unit.storage_name, unit.storage_name, storage, field.offset);
            append(builder, "}\n");
        }
    }
    append(builder, "\n");
}

bit_mask :: (width: int) -> u64 {
    if width >= 64  return 0xFFFF_FFFF_FFFF_FFFF;
    return ((cast(u64) 1) << (cast(u64) width)) - 1;
}

// ------------------------------------------------------------------------------------
// vulkan_video.jai
// ------------------------------------------------------------------------------------

// video.xml has no <feature> blocks, so nothing is marked required; we emit all of it.
// It is only type declarations, which cost nothing if unused. The StdVideo* names are
// already namespaced by their own prefix and are not Vulkan's, so they keep it.
emit_video_file :: (reg: *Registry) -> string {
    builder: String_Builder;
    banner(*builder, reg, "StdVideo* types from the Vulkan video registry (video.xml)");

    record_name("MAKE_VIDEO_STD_VERSION", "VK_MAKE_VIDEO_STD_VERSION");
    append(*builder, #string TEXT
// These describe the bitstream-level structures of the video codecs themselves (H.264,
// H.265, AV1, VP9) and are referenced by the KHR video extensions.

MAKE_VIDEO_STD_VERSION :: inline (major: u32, minor: u32, patch: u32) -> u32 {
    return (major << 22) | (minor << 12) | patch;
}

TEXT);

    section(*builder, "Video constants");
    for reg.types {
        if it.category != .DEFINE  continue;
        if it.name == "VK_MAKE_VIDEO_STD_VERSION"  continue;   // emitted as a procedure above
        value := video_define_value(it.comment);
        if !value  continue;
        print_to_builder(*builder, "% :: %;\n", record_name(constant_name(it.name), it.name), value);
    }
    append(*builder, "\n");

    // The STD_VIDEO_* sizes, which the structs further down use as array lengths.
    emit_unique_constants(*builder, reg);

    section(*builder, "Video enumerations");
    for reg.groups {
        it.required = true;
        it.guard    = "";
        emit_enum_group(*builder, it);
    }

    section(*builder, "Video structs");
    for reg.types {
        if it.category != .STRUCT && it.category != .UNION  continue;
        it.guard = "";
        emit_aggregate(*builder, it);
    }

    return builder_to_string(*builder);
}

// video.xml's defines look like `#define VK_STD_VULKAN_VIDEO_CODEC_H264_DECODE_API_VERSION_1_0_0 \
// VK_MAKE_VIDEO_STD_VERSION(1, 0, 0)`; we only want the version macro calls, rewritten as a
// call to our procedure.
video_define_value :: (text: string) -> string {
    found, after_open := contains(text, "VK_MAKE_VIDEO_STD_VERSION(");
    if !found  return "";

    close := 0;
    while close < after_open.count && after_open[close] != #char ")"  close += 1;

    arguments := split(slice(after_open, 0, close), ",");
    if arguments.count != 3  return "";

    return tprint("#run MAKE_VIDEO_STD_VERSION(%, %, %)",
                  trim(arguments[0]), trim(arguments[1]), trim(arguments[2]));
}
