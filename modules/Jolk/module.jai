//
// Jolk -- Vulkan for Jai
//
// Generated by Jolk's generator from the Vulkan registry. Do not edit by hand:
// re-run the generator in generator/ instead.
//
// Vulkan header version: 357
//

// Import it under a name; everything in here is spelled without the C prefixes:
//
//     Vk :: #import "Jolk";
//
//     info: Vk.ImageCreateInfo;
//     info.initialLayout = .UNDEFINED;
//     Vk.CreateImage(device, *info, null, *image);
//
// For the C spellings (VkImageCreateInfo, vkCreateImage), import it through Jolk/C_Names;
// see that module for how.
//
// Platform parameters. Each one matches the VK_USE_PLATFORM_* macro of the same name in
// the C headers, and turning one on adds that window system's types, structs and commands.
// Unlike the C headers you can have several on at once, which is what you want on Linux.
//
//     Vk :: #import "Jolk"(VK_USE_PLATFORM_WAYLAND_KHR = true);
//
// Import Jolk with the same parameters everywhere in a program. Each distinct set of
// parameters is a separate instance of the module, with its own types and its own loaded
// entry points, and they do not interoperate.
//
#module_parameters (
    VK_ENABLE_BETA_EXTENSIONS       := false,
    VK_USE_PLATFORM_ANDROID_KHR     := OS == .ANDROID,
    VK_USE_PLATFORM_DIRECTFB_EXT    := false,
    VK_USE_PLATFORM_FUCHSIA         := false,
    VK_USE_PLATFORM_GGP             := false,
    VK_USE_PLATFORM_IOS_MVK         := false,
    VK_USE_PLATFORM_MACOS_MVK       := OS == .MACOS,
    VK_USE_PLATFORM_METAL_EXT       := OS == .MACOS,
    VK_USE_PLATFORM_OHOS            := false,
    VK_USE_PLATFORM_SCREEN_QNX      := false,
    VK_USE_PLATFORM_UBM_SEC         := false,
    VK_USE_PLATFORM_VI_NN           := false,
    VK_USE_PLATFORM_WAYLAND_KHR     := OS == .LINUX,
    VK_USE_PLATFORM_WIN32_KHR       := OS == .WINDOWS,
    VK_USE_PLATFORM_XCB_KHR         := OS == .LINUX,
    VK_USE_PLATFORM_XLIB_KHR        := OS == .LINUX,
    VK_USE_PLATFORM_XLIB_XRANDR_EXT := false
);

#load "vulkan_platform.jai";   // window-system types the platform extensions refer to
#load "vulkan_types.jai";      // handles, enums, constants, structs and unions
#load "vulkan_video.jai";      // the StdVideo* types the video extensions use
#load "vulkan_loader.jai";     // the volk-style entry-point loader

// Jolk imports nothing. The loader opens the Vulkan library through the OS directly, so
// this module adds no dependencies and nothing to link against.
